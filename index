  <script>
    const todayKey = new Date().toISOString().split('T')[0];
    document.getElementById('dateHeader').textContent = new Date().toLocaleDateString('es-ES', {
      weekday: 'long', day: 'numeric', month: 'long'
    });

    const defaultCfg = {
      dayType: 'train',
      model: 'gemini-2.5-flash',
      oilFactor: 1.0,
      autoHealthSync: false,
      shortcutName: 'NutriOS Health Sync',
      train: { kcal: 2950, prot: 170, carb: 365, fat: 88 },
      rest:  { kcal: 2550, prot: 170, carb: 275, fat: 82 }
    };

    const defaultPresets = [
      { id: 'p1', icon: 'CupSoda', name: 'Batido Hipercalórico', weight: 550, kcal: 780, prot: 34, carb: 96, fat: 28, fiber: 8, items: ['300ml leche', '80g avena', '30g crema cacahuete', '1 plátano'] },
      { id: 'p2', icon: 'Beef', name: 'Pollo y Arroz', weight: 420, kcal: 610, prot: 52, carb: 78, fat: 9, fiber: 2, items: ['200g pechuga pollo', '220g arroz cocido'] },
      { id: 'p3', icon: 'Egg', name: '4 Huevos + Tostadas', weight: 310, kcal: 490, prot: 31, carb: 34, fat: 25, fiber: 3, items: ['4 huevos L', '2 rebanadas pan', 'AOVE'] },
      { id: 'p4', icon: 'Fish', name: 'Atún con Pasta', weight: 400, kcal: 580, prot: 42, carb: 76, fat: 11, fiber: 4, items: ['2 latas atún', '220g pasta', 'Tomate'] }
    ];

    function getCfg() {
      return { ...defaultCfg, ...(JSON.parse(localStorage.getItem('nutrios_pro_cfg')) || {}) };
    }
    function saveCfg(cfg) {
      localStorage.setItem('nutrios_pro_cfg', JSON.stringify(cfg));
      renderUI();
    }

    function getAllDays() {
      return JSON.parse(localStorage.getItem('nutrios_pro_days') || '{}');
    }
    function getToday() {
      const all = getAllDays();
      if (!all[todayKey]) {
        all[todayKey] = { meals: [], water: 0, weight: null };
        localStorage.setItem('nutrios_pro_days', JSON.stringify(all));
      }
      return all[todayKey];
    }
    function saveToday(data) {
      const all = getAllDays();
      all[todayKey] = data;
      localStorage.setItem('nutrios_pro_days', JSON.stringify(all));
      renderUI();
    }

    function getPresets() {
      return JSON.parse(localStorage.getItem('nutrios_pro_presets')) || defaultPresets;
    }
    function savePresets(list) {
      localStorage.setItem('nutrios_pro_presets', JSON.stringify(list));
      renderUI();
    }

    // Navegación entre vistas
    function switchView(view) {
      ['today', 'analytics', 'favorites', 'settings'].forEach(v => {
        document.getElementById(`view-${v}`).classList.toggle('hidden', v !== view);
        const btn = document.getElementById(`tabbtn-${v}`);
        if (btn) btn.className = `flex flex-col items-center justify-center gap-1 w-14 ${v === view ? 'text-[#0A84FF]' : 'text-[#8E8E93]'}`;
      });
      const titles = { today: 'Resumen', analytics: 'Analítica', favorites: 'Favoritos', settings: 'Ajustes' };
      document.getElementById('viewTitle').textContent = titles[view];
      if (view === 'settings') loadSettingsForm();
      if (view === 'analytics') renderAnalyticsView();
      lucide.createIcons();
    }

    function setDayType(type) {
      const cfg = getCfg();
      cfg.dayType = type;
      saveCfg(cfg);
    }

    // Puente con Apple Salud mediante URL Scheme oficial de Atajos de iOS
    function syncWithAppleHealth(customPayload = null) {
      const cfg = getCfg();
      const today = getToday();

      let kcal = 0, prot = 0, carb = 0, fat = 0, fiber = 0;
      today.meals.forEach(m => {
        kcal  += Math.round(m.baseKcal * m.scale);
        prot  += Math.round(m.baseProt * m.scale);
        carb  += Math.round(m.baseCarb * m.scale);
        fat   += Math.round(m.baseFat * m.scale);
        fiber += Math.round((m.baseFiber || 0) * m.scale);
      });

      const payload = customPayload || {
        date: todayKey,
        calories: kcal,
        protein: prot,
        carbs: carb,
        fat: fat,
        fiber: fiber,
        waterLiters: today.water,
        weightKg: today.weight || ''
      };

      const shortcutName = encodeURIComponent(cfg.shortcutName || 'NutriOS Health Sync');
      const encodedInput = encodeURIComponent(JSON.stringify(payload));
      window.location.href = `shortcuts://run-shortcut?name=${shortcutName}&input=text&text=${encodedInput}`;
    }

    function addWater(amount) {
      const today = getToday();
      today.water = Math.max(0, +(today.water + amount).toFixed(2));
      saveToday(today);
    }

    function saveWeight() {
      const val = parseFloat(document.getElementById('inpWeight').value);
      if (!val) return;
      const today = getToday();
      today.weight = val;
      document.getElementById('inpWeight').value = '';
      saveToday(today);
      if (getCfg().autoHealthSync) syncWithAppleHealth({ weightKg: val });
    }

    function logPreset(id) {
      const p = getPresets().find(x => x.id === id);
      if (!p) return;
      const today = getToday();
      const newMeal = {
        id: Date.now(),
        icon: p.icon || 'Utensils',
        name: p.name,
        time: new Date().toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' }),
        scale: 1,
        baseWeight: p.weight,
        baseKcal: p.kcal,
        baseProt: p.prot,
        baseCarb: p.carb,
        baseFat: p.fat,
        baseFiber: p.fiber || 3,
        items: p.items || []
      };
      today.meals.unshift(newMeal);
      saveToday(today);
      if (getCfg().autoHealthSync) {
        syncWithAppleHealth({ calories: p.kcal, protein: p.prot, carbs: p.carb, fat: p.fat, fiber: p.fiber || 3 });
      }
    }

    function addNewPreset() {
      const name = document.getElementById('favName').value.trim();
      if (!name) return;
      const list = getPresets();
      list.unshift({
        id: 'fav_' + Date.now(),
        icon: document.getElementById('favIcon').value,
        name,
        weight: Number(document.getElementById('favWeight').value) || 350,
        kcal: Number(document.getElementById('favKcal').value) || 500,
        prot: Number(document.getElementById('favProt').value) || 35,
        carb: Number(document.getElementById('favCarb').value) || 55,
        fat: Number(document.getElementById('favFat').value) || 15,
        fiber: 4,
        items: ['Plato favorito']
      });
      savePresets(list);
      ['favName', 'favWeight', 'favKcal', 'favProt', 'favCarb', 'favFat'].forEach(id => document.getElementById(id).value = '');
    }

    function deletePreset(id) {
      savePresets(getPresets().filter(p => p.id !== id));
    }

    function updateScale(mealId, val) {
      const today = getToday();
      today.meals = today.meals.map(m => m.id === mealId ? { ...m, scale: parseFloat(val) } : m);
      saveToday(today);
    }

    function deleteMeal(mealId) {
      const today = getToday();
      today.meals = today.meals.filter(m => m.id !== mealId);
      saveToday(today);
    }

    function saveMealToFavorites(mealId) {
      const m = getToday().meals.find(x => x.id === mealId);
      if (!m) return;
      const list = getPresets();
      list.unshift({
        id: 'fav_' + Date.now(),
        icon: 'Utensils',
        name: m.name,
        weight: Math.round(m.baseWeight * m.scale),
        kcal: Math.round(m.baseKcal * m.scale),
        prot: Math.round(m.baseProt * m.scale),
        carb: Math.round(m.baseCarb * m.scale),
        fat: Math.round(m.baseFat * m.scale),
        fiber: Math.round((m.baseFiber || 3) * m.scale),
        items: m.items || []
      });
      savePresets(list);
    }

    function toggleTextModal(show) {
      document.getElementById('textModal').classList.toggle('hidden', !show);
    }

    // Compresión de imagen rápida para iPhone 13
    function compressImage(file, maxW = 960) {
      return new Promise((resolve) => {
        const reader = new FileReader();
        reader.onload = (e) => {
          const img = new Image();
          img.onload = () => {
            const canvas = document.createElement('canvas');
            const r = Math.min(maxW / img.width, 1);
            canvas.width = img.width * r;
            canvas.height = img.height * r;
            const ctx = canvas.getContext('2d');
            ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
            const dataUrl = canvas.toDataURL('image/jpeg', 0.8);
            resolve({ base64: dataUrl.split(',')[1], thumb: dataUrl });
          };
          img.src = e.target.result;
        };
        reader.readAsDataURL(file);
      });
    }

    async function callGemini(parts, thumb = null) {
      const apiKey = localStorage.getItem('nutrios_pro_apikey');
      if (!apiKey) {
        switchView('settings');
        alert('Introduce primero tu Gemini API Key en Ajustes.');
        return;
      }

      const cfg = getCfg();
      document.getElementById('aiStatusCard').classList.remove('hidden');

      const schema = {
        type: "OBJECT",
        properties: {
          dishName: { type: "STRING" },
          totalWeightGrams: { type: "INTEGER" },
          calories: { type: "INTEGER" },
          proteinGrams: { type: "INTEGER" },
          carbsGrams: { type: "INTEGER" },
          fatGrams: { type: "INTEGER" },
          fiberGrams: { type: "INTEGER" },
          ingredients: { type: "ARRAY", items: { type: "STRING" } }
        },
        required: ["dishName", "totalWeightGrams", "calories", "proteinGrams", "carbsGrams", "fatGrams", "fiberGrams", "ingredients"]
      };

      try {
        const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/${cfg.model}:generateContent?key=${apiKey}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            contents: [{ parts }],
            generationConfig: {
              responseMimeType: "application/json",
              responseSchema: schema,
              temperature: 0.15
            }
          })
        });

        const resJson = await response.json();
        const data = JSON.parse(resJson.candidates[0].content.parts[0].text);

        const oilFactor = parseFloat(cfg.oilFactor || 1.0);
        const finalFat = Math.round(data.fatGrams * oilFactor);
        const finalKcal = Math.round(data.calories + (finalFat - data.fatGrams) * 9);

        const today = getToday();
        today.meals.unshift({
          id: Date.now(),
          icon: 'Utensils',
          name: data.dishName,
          time: new Date().toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' }),
          scale: 1,
          thumb,
          baseWeight: data.totalWeightGrams,
          baseKcal: finalKcal,
          baseProt: data.proteinGrams,
          baseCarb: data.carbsGrams,
          baseFat: finalFat,
          baseFiber: data.fiberGrams,
          items: data.ingredients
        });
        saveToday(today);

        if (cfg.autoHealthSync) {
          syncWithAppleHealth({
            calories: finalKcal,
            protein: data.proteinGrams,
            carbs: data.carbsGrams,
            fat: finalFat,
            fiber: data.fiberGrams
          });
        }
      } catch (err) {
        alert('Error al conectar con Gemini API. Comprueba tu clave en Ajustes.');
        console.error(err);
      } finally {
        document.getElementById('aiStatusCard').classList.add('hidden');
      }
    }

    async function handleImageUpload(e) {
      const file = e.target.files[0];
      if (!file) return;
      switchView('today');
      const { base64, thumb } = await compressImage(file);
      await callGemini([
        { text: "Actúa como nutricionista clínico. Analiza este plato, estima el peso en gramos de cada componente usando referencias espaciales del plato y calcula calorías, proteínas, carbohidratos, grasas y fibra en español." },
        { inlineData: { mimeType: "image/jpeg", data: base64 } }
      ], thumb);
      e.target.value = '';
    }

