<!DOCTYPE html>
<html lang="es" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="NutriOS" />
  <meta name="theme-color" content="#000000" />
  <title>NutriOS Pro</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <style>
    :root {
      --bg-primary: #000000;
      --bg-grouped: #1C1C1E;
      --bg-tertiary: #2C2C2E;
      --bg-elevated: #3A3A3C;
      --sep-opaque: #38383A;
      --sep-non-opaque: rgba(84, 84, 88, 0.65);
      --label-primary: #FFFFFF;
      --label-secondary: #8E8E93;
      --label-tertiary: #48484A;
      --sys-blue: #0A84FF;
      --sys-green: #30D158;
      --sys-orange: #FF9F0A;
      --sys-red: #FF453A;
      --sys-cyan: #64D2FF;
      --sys-purple: #BF5AF2;
      --sys-pink: #FF2D55;
    }

    * {
      -webkit-tap-highlight-color: transparent;
      -webkit-touch-callout: none;
      box-sizing: border-box;
      user-select: none;
    }

    input, textarea, select {
      user-select: text;
    }

    /* Bloqueo de viewport exacto para iPhone 13 (390x844pt) */
    html, body {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      background-color: var(--bg-primary);
      color: var(--label-primary);
      font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    .app-shell {
      position: fixed;
      inset: 0;
      max-width: 390px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      background-color: var(--bg-primary);
    }

    .scroll-viewport {
      flex: 1;
      overflow-y: auto;
      overflow-x: hidden;
      -webkit-overflow-scrolling: touch;
      padding-top: calc(env(safe-area-inset-top, 47px) + 8px);
      padding-bottom: calc(env(safe-area-inset-bottom, 34px) + 88px);
      padding-left: 16px;
      padding-right: 16px;
    }

    .scroll-viewport::-webkit-scrollbar,
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }

    /* Tarjetas e interfaces nativas Apple HIG */
    .ios-card {
      background-color: var(--bg-grouped);
      border-radius: 16px;
      padding: 16px;
      border: 0.5px solid rgba(255, 255, 255, 0.06);
    }

    .ios-card-sm {
      background-color: var(--bg-grouped);
      border-radius: 14px;
      padding: 12px 14px;
      border: 0.5px solid rgba(255, 255, 255, 0.06);
    }

    .ios-list {
      background-color: var(--bg-grouped);
      border-radius: 12px;
      overflow: hidden;
      border: 0.5px solid rgba(255, 255, 255, 0.06);
    }

    .ios-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-height: 44px;
      padding: 10px 16px;
      border-bottom: 0.5px solid var(--sep-non-opaque);
    }

    .ios-row:last-child {
      border-bottom: none;
    }

    .ios-tabbar {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      max-width: 390px;
      margin: 0 auto;
      height: calc(54px + env(safe-area-inset-bottom, 34px));
      padding-bottom: env(safe-area-inset-bottom, 34px);
      background: rgba(22, 22, 24, 0.82);
      backdrop-filter: saturate(180%) blur(25px);
      -webkit-backdrop-filter: saturate(180%) blur(25px);
      border-top: 0.5px solid var(--sep-non-opaque);
      z-index: 30;
    }

    .ios-segmented {
      background-color: var(--bg-grouped);
      padding: 2px;
      border-radius: 9px;
      display: inline-flex;
      border: 0.5px solid rgba(255, 255, 255, 0.07);
    }

    .ios-seg-btn {
      padding: 5px 11px;
      border-radius: 7px;
      font-size: 12px;
      font-weight: 600;
      color: var(--label-secondary);
      display: flex;
      align-items: center;
      gap: 5px;
      transition: all 0.18s ease;
    }

    .ios-seg-btn.active {
      background-color: var(--bg-elevated);
      color: #FFFFFF;
      box-shadow: 0 1px 4px rgba(0, 0, 0, 0.4);
    }

    .ring-anim {
      transition: stroke-dashoffset 0.6s cubic-bezier(0.22, 1, 0.36, 1);
      transform: rotate(-90deg);
      transform-origin: 50% 50%;
    }

    input[type="range"] {
      -webkit-appearance: none;
      appearance: none;
      height: 4px;
      background: var(--bg-tertiary);
      border-radius: 999px;
    }
    input[type="range"]::-webkit-slider-thumb {
      -webkit-appearance: none;
      width: 18px;
      height: 18px;
      border-radius: 50%;
      background: #FFFFFF;
      box-shadow: 0 1px 5px rgba(0,0,0,0.5);
    }

    .ios-switch {
      position: relative;
      width: 46px;
      height: 28px;
      background: var(--bg-tertiary);
      border-radius: 999px;
      transition: background 0.2s;
      cursor: pointer;
    }
    .ios-switch.on {
      background: var(--sys-green);
    }
    .ios-switch::after {
      content: "";
      position: absolute;
      top: 2px;
      left: 2px;
      width: 24px;
      height: 24px;
      background: #fff;
      border-radius: 50%;
      transition: transform 0.2s cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    .ios-switch.on::after {
      transform: translateX(18px);
    }
  </style>
</head>
<body>

  <div class="app-shell">
    <div class="scroll-viewport">

      <!-- CABECERA NATIVA iOS -->
      <header class="flex justify-between items-end mb-4">
        <div>
          <p id="dateHeader" class="text-[11px] font-semibold uppercase tracking-wider text-[#8E8E93]"></p>
          <h1 id="viewTitle" class="text-[30px] leading-[34px] font-bold tracking-tight text-white">Resumen</h1>
        </div>

        <div class="ios-segmented">
          <button id="segTrain" onclick="setDayType('train')" class="ios-seg-btn active">
            <i data-lucide="Flame" class="w-3.5 h-3.5 text-[#FF9F0A]"></i>
            <span>Entreno</span>
          </button>
          <button id="segRest" onclick="setDayType('rest')" class="ios-seg-btn">
            <i data-lucide="Moon" class="w-3.5 h-3.5 text-[#64D2FF]"></i>
            <span>Descanso</span>
          </button>
        </div>
      </header>

      <!-- ==========================================
           VISTA 1: RESUMEN DIARIO (APPLE HEALTH STYLE)
           ========================================== -->
      <div id="view-today" class="space-y-3.5">

        <!-- Tarjeta de Anillos Concéntricos y Macros -->
        <section class="ios-card">
          <div class="flex items-center justify-between mb-3">
            <div class="flex items-center gap-1.5">
              <i data-lucide="Activity" class="w-4 h-4 text-[#30D158]"></i>
              <span class="text-[13px] font-semibold text-white">Balance Energético</span>
            </div>
            <span id="remBadge" class="text-[11px] font-semibold px-2.5 py-0.5 rounded-full bg-[#30D158]/15 text-[#30D158]">Restan 2950 kcal</span>
          </div>

          <div class="flex items-center gap-4">
            <!-- Doble Anillo Concéntrico SVG -->
            <div class="relative w-[132px] h-[132px] shrink-0 flex items-center justify-center">
              <svg class="w-full h-full" viewBox="0 0 120 120">
                <circle cx="60" cy="60" r="50" stroke="#2C2C2E" stroke-width="11" fill="none" />
                <circle id="ringKcal" class="ring-anim" cx="60" cy="60" r="50" stroke="#30D158" stroke-width="11" stroke-linecap="round" fill="none" stroke-dasharray="314.16" stroke-dashoffset="314.16" />
                <circle cx="60" cy="60" r="36" stroke="#2C2C2E" stroke-width="9" fill="none" />
                <circle id="ringProt" class="ring-anim" cx="60" cy="60" r="36" stroke="#0A84FF" stroke-width="9" stroke-linecap="round" fill="none" stroke-dasharray="226.19" stroke-dashoffset="226.19" />
              </svg>
              <div class="absolute inset-0 flex flex-col items-center justify-center">
                <span id="lblKcalDone" class="text-[22px] font-bold tracking-tight leading-none">0</span>
                <span id="lblKcalTarget" class="text-[10px] font-medium text-[#8E8E93] mt-1">/ 2950 KCAL</span>
              </div>
            </div>

            <!-- Barras de Macronutrientes -->
            <div class="flex-1 space-y-2.5">
              <div>
                <div class="flex justify-between text-[12px] mb-1">
                  <span class="font-medium text-[#0A84FF] flex items-center gap-1">
                    <i data-lucide="Dumbbell" class="w-3 h-3"></i> Proteínas
                  </span>
                  <span class="font-semibold"><span id="lblProtDone">0</span><span class="text-[#8E8E93] font-normal">/<span id="lblProtGoal">170</span>g</span></span>
                </div>
                <div class="h-1.5 w-full bg-[#2C2C2E] rounded-full overflow-hidden">
                  <div id="barProt" class="h-full bg-[#0A84FF] rounded-full transition-all duration-500" style="width:0%"></div>
                </div>
              </div>

              <div>
                <div class="flex justify-between text-[12px] mb-1">
                  <span class="font-medium text-[#FF9F0A] flex items-center gap-1">
                    <i data-lucide="Zap" class="w-3 h-3"></i> Carbos
                  </span>
                  <span class="font-semibold"><span id="lblCarbDone">0</span><span class="text-[#8E8E93] font-normal">/<span id="lblCarbGoal">365</span>g</span></span>
                </div>
                <div class="h-1.5 w-full bg-[#2C2C2E] rounded-full overflow-hidden">
                  <div id="barCarb" class="h-full bg-[#FF9F0A] rounded-full transition-all duration-500" style="width:0%"></div>
                </div>
              </div>

              <div>
                <div class="flex justify-between text-[12px] mb-1">
                  <span class="font-medium text-[#FF453A] flex items-center gap-1">
                    <i data-lucide="Droplet" class="w-3 h-3"></i> Grasas
                  </span>
                  <span class="font-semibold"><span id="lblFatDone">0</span><span class="text-[#8E8E93] font-normal">/<span id="lblFatGoal">88</span>g</span></span>
                </div>
                <div class="h-1.5 w-full bg-[#2C2C2E] rounded-full overflow-hidden">
                  <div id="barFat" class="h-full bg-[#FF453A] rounded-full transition-all duration-500" style="width:0%"></div>
                </div>
              </div>

              <div class="pt-1.5 border-t border-[#2C2C2E] flex justify-between items-center text-[11px] text-[#8E8E93]">
                <span>Fibra: <strong id="lblFiberDone" class="text-white">0g</strong></span>
                <button onclick="syncWithAppleHealth()" class="flex items-center gap-1 text-[#FF2D55] font-semibold active:opacity-70">
                  <i data-lucide="Heart" class="w-3 h-3 fill-[#FF2D55]"></i>
                  <span>Sincronizar Salud</span>
                </button>
              </div>
            </div>
          </div>
        </section>

        <!-- Grid 2 Columnas: Hidratación y Peso Corporal -->
        <section class="grid grid-cols-2 gap-3">
          <!-- Hidratación -->
          <div class="ios-card-sm flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between">
                <span class="text-[11px] font-semibold uppercase tracking-wide text-[#64D2FF]">Agua</span>
                <i data-lucide="GlassWater" class="w-4 h-4 text-[#64D2FF]"></i>
              </div>
              <div class="mt-1 flex items-baseline gap-1">
                <span id="lblWater" class="text-[20px] font-bold">0.00</span>
                <span class="text-[11px] text-[#8E8E93]">/ 3.0 L</span>
              </div>
            </div>
            <div class="grid grid-cols-3 gap-1.5 mt-2.5">
              <button onclick="addWater(0.25)" class="bg-[#2C2C2E] active:bg-[#3A3A3C] py-1.5 rounded-lg text-[11px] font-semibold text-[#64D2FF]">+250</button>
              <button onclick="addWater(0.5)" class="bg-[#2C2C2E] active:bg-[#3A3A3C] py-1.5 rounded-lg text-[11px] font-semibold text-[#64D2FF]">+500</button>
              <button onclick="addWater(-0.25)" class="bg-[#2C2C2E] active:bg-[#3A3A3C] py-1.5 rounded-lg text-[11px] font-semibold text-[#8E8E93]">-</button>
            </div>
          </div>

          <!-- Peso Corporal -->
          <div class="ios-card-sm flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between">
                <span class="text-[11px] font-semibold uppercase tracking-wide text-[#BF5AF2]">Peso</span>
                <i data-lucide="Scale" class="w-4 h-4 text-[#BF5AF2]"></i>
              </div>
              <div class="mt-1 flex items-baseline gap-1">
                <span id="lblWeight" class="text-[20px] font-bold">--</span>
                <span class="text-[11px] text-[#8E8E93]">kg hoy</span>
              </div>
            </div>
            <div class="flex gap-1.5 mt-2.5">
              <input id="inpWeight" type="number" step="0.1" placeholder="74.5" class="w-full bg-[#2C2C2E] text-white text-[12px] rounded-lg px-2.5 py-1.5 focus:outline-none" />
              <button onclick="saveWeight()" class="bg-[#BF5AF2] active:opacity-80 text-white px-2.5 rounded-lg flex items-center justify-center">
                <i data-lucide="Check" class="w-3.5 h-3.5"></i>
              </button>
            </div>
          </div>
        </section>

        <!-- Acceso Rápido 1 Toque (Sin Emojis — Con Iconos) -->
        <section>
          <div class="flex justify-between items-center mb-2 px-0.5">
            <span class="text-[11px] font-semibold uppercase tracking-wider text-[#8E8E93]">Registro Rápido</span>
            <button onclick="switchView('favorites')" class="text-[12px] text-[#0A84FF] font-medium flex items-center gap-0.5">
              <span>Gestionar</span>
              <i data-lucide="ChevronRight" class="w-3.5 h-3.5"></i>
            </button>
          </div>
          <div id="presetsCarousel" class="flex gap-2.5 overflow-x-auto no-scrollbar pb-0.5"></div>
        </section>

        <!-- Banner de Procesamiento IA -->
        <div id="aiStatusCard" class="hidden ios-card border border-[#0A84FF]/40 flex items-center gap-3">
          <div class="w-5 h-5 border-2 border-[#0A84FF] border-t-transparent rounded-full animate-spin shrink-0"></div>
          <div>
            <p class="text-[13px] font-semibold text-white">Analizando imagen con Gemini Vision</p>
            <p class="text-[11px] text-[#8E8E93]">Estimando gramaje por volumetría y densidad nutricional...</p>
          </div>
        </div>

        <!-- Registro Cronológico de Comidas -->
        <section>
          <div class="flex justify-between items-center mb-2 px-0.5">
            <span class="text-[11px] font-semibold uppercase tracking-wider text-[#8E8E93]">Comidas de Hoy</span>
            <button onclick="toggleTextModal(true)" class="text-[12px] text-[#0A84FF] font-medium flex items-center gap-1">
              <i data-lucide="PenLine" class="w-3.5 h-3.5"></i>
              <span>Escribir plato</span>
            </button>
          </div>
          <div id="mealsList" class="space-y-2.5"></div>
        </section>

      </div>

      <!-- ==========================================
           VISTA 2: ANALÍTICA Y TENDENCIAS
           ========================================== -->
      <div id="view-analytics" class="hidden space-y-3.5">
        <div class="grid grid-cols-3 gap-2.5">
          <div class="ios-card-sm">
            <span class="text-[11px] text-[#8E8E93] block">Media 7d</span>
            <span id="statAvgKcal" class="text-[17px] font-bold text-white mt-0.5 block">0 kcal</span>
          </div>
          <div class="ios-card-sm">
            <span class="text-[11px] text-[#8E8E93] block">Proteína 7d</span>
            <span id="statAvgProt" class="text-[17px] font-bold text-[#0A84FF] mt-0.5 block">0 g</span>
          </div>
          <div class="ios-card-sm">
            <span class="text-[11px] text-[#8E8E93] block">Constancia</span>
            <span id="statAdherence" class="text-[17px] font-bold text-[#30D158] mt-0.5 block">0%</span>
          </div>
        </div>

        <section class="ios-card">
          <div class="flex justify-between items-center mb-3">
            <div>
              <h3 class="text-[14px] font-semibold text-white">Evolución Calórica (7 días)</h3>
              <p class="text-[11px] text-[#8E8E93]">Comparativa frente a tu meta diaria</p>
            </div>
            <i data-lucide="BarChart3" class="w-4 h-4 text-[#8E8E93]"></i>
          </div>
          <div id="chart7Days" class="h-40 flex items-end justify-between gap-2 pt-5 pb-1 px-1 border-b border-[#2C2C2E]"></div>
        </section>

        <section class="ios-card">
          <h3 class="text-[14px] font-semibold text-white mb-2.5">Reparto Calórico de Hoy</h3>
          <div class="w-full h-3 bg-[#2C2C2E] rounded-full overflow-hidden flex mb-3">
            <div id="barSplitP" class="bg-[#0A84FF] h-full transition-all" style="width: 30%"></div>
            <div id="barSplitC" class="bg-[#FF9F0A] h-full transition-all" style="width: 45%"></div>
            <div id="barSplitF" class="bg-[#FF453A] h-full transition-all" style="width: 25%"></div>
          </div>
          <div class="grid grid-cols-3 text-[12px] text-center">
            <div><span class="inline-block w-2 h-2 rounded-full bg-[#0A84FF] mr-1"></span>Prot <strong id="pctP">0%</strong></div>
            <div><span class="inline-block w-2 h-2 rounded-full bg-[#FF9F0A] mr-1"></span>Carb <strong id="pctC">0%</strong></div>
            <div><span class="inline-block w-2 h-2 rounded-full bg-[#FF453A] mr-1"></span>Grasa <strong id="pctF">0%</strong></div>
          </div>
        </section>

        <section class="ios-card">
          <div class="flex justify-between items-center mb-2">
            <h3 class="text-[14px] font-semibold text-white">Registro de Peso Corporal</h3>
            <i data-lucide="TrendingUp" class="w-4 h-4 text-[#BF5AF2]"></i>
          </div>
          <div id="weightHistoryBox" class="divide-y divide-[#2C2C2E] text-[12px]"></div>
        </section>
      </div>

      <!-- ==========================================
           VISTA 3: PLATOS FAVORITOS (1 TOQUE)
           ========================================== -->
      <div id="view-favorites" class="hidden space-y-4">
        <section class="ios-card space-y-3">
          <div class="flex items-center gap-2">
            <i data-lucide="BookmarkPlus" class="w-4 h-4 text-[#0A84FF]"></i>
            <h3 class="text-[14px] font-semibold text-white">Nuevo Plato Frecuente</h3>
          </div>
          <input id="favName" type="text" placeholder="Nombre del plato (ej. Batido Avena y Cacahuete)" class="w-full bg-[#2C2C2E] rounded-xl px-3 py-2 text-[13px] text-white focus:outline-none" />
          <div class="grid grid-cols-3 gap-2">
            <select id="favIcon" class="bg-[#2C2C2E] rounded-xl px-2.5 py-2 text-[12px] text-white focus:outline-none">
              <option value="CupSoda">Icono: Batido</option>
              <option value="Utensils">Icono: Plato</option>
              <option value="Beef">Icono: Carne/Ave</option>
              <option value="Fish">Icono: Pescado</option>
              <option value="Egg">Icono: Huevos</option>
              <option value="Coffee">Icono: Café/Snack</option>
            </select>
            <input id="favWeight" type="number" placeholder="Gramos (g)" class="bg-[#2C2C2E] rounded-xl px-3 py-2 text-[13px] text-white focus:outline-none" />
            <input id="favKcal" type="number" placeholder="Kcal" class="bg-[#2C2C2E] rounded-xl px-3 py-2 text-[13px] text-white focus:outline-none" />
          </div>
          <div class="grid grid-cols-3 gap-2">
            <input id="favProt" type="number" placeholder="Proteína (g)" class="bg-[#2C2C2E] rounded-xl px-3 py-2 text-[13px] text-white focus:outline-none" />
            <input id="favCarb" type="number" placeholder="Carbos (g)" class="bg-[#2C2C2E] rounded-xl px-3 py-2 text-[13px] text-white focus:outline-none" />
            <input id="favFat" type="number" placeholder="Grasas (g)" class="bg-[#2C2C2E] rounded-xl px-3 py-2 text-[13px] text-white focus:outline-none" />
          </div>
          <button onclick="addNewPreset()" class="w-full bg-[#0A84FF] active:opacity-80 text-white font-semibold py-2.5 rounded-xl text-[13px]">Guardar en Acceso Rápido</button>
        </section>

        <section>
          <span class="text-[11px] font-semibold uppercase tracking-wider text-[#8E8E93] px-1 block mb-2">Mis Platos Guardados</span>
          <div id="savedPresetsList" class="ios-list"></div>
        </section>
      </div>

      <!-- ==========================================
           VISTA 4: AJUSTES (iOS SETTINGS + APPLE HEALTH)
           ========================================== -->
      <div id="view-settings" class="hidden space-y-5">

        <!-- Integración con Apple Salud -->
        <div>
          <span class="text-[11px] font-semibold uppercase tracking-wider text-[#8E8E93] px-3 block mb-1.5">Apple Salud (HealthKit Bridge)</span>
          <div class="ios-list">
            <div class="ios-row">
              <div class="flex items-center gap-2.5">
                <div class="w-7 h-7 rounded-lg bg-[#FF2D55] flex items-center justify-center">
                  <i data-lucide="Heart" class="w-4 h-4 text-white fill-white"></i>
                </div>
                <div>
                  <div class="text-[13px] font-medium text-white">Auto-Sync con Apple Salud</div>
                  <div class="text-[11px] text-[#8E8E93]">Envía cada plato a Salud vía Atajos</div>
                </div>
              </div>
              <div id="toggleHealthSync" onclick="toggleHealthAutoSync()" class="ios-switch"></div>
            </div>
            <div class="ios-row">
              <span class="text-[13px] text-[#8E8E93]">Nombre del Atajo iOS</span>
              <input id="cfgShortcutName" type="text" value="NutriOS Health Sync" class="bg-transparent text-right text-[13px] text-white focus:outline-none w-44" />
            </div>
            <button onclick="syncWithAppleHealth()" class="ios-row w-full text-left text-[13px] text-[#0A84FF] font-medium">
              <span>Sincronizar totales de hoy con Apple Salud ahora</span>
