        kcal: Number(document.getElementById('tKcal').value) || 2950,
        prot: Number(document.getElementById('tProt').value) || 170,
        carb: Number(document.getElementById('tCarb').value) || 365,
        fat:  Number(document.getElementById('tFat').value)  || 88
