    function copyObsidianMarkdown() {
      const today = getToday();
      const lines = [
        `# Nutrición (${todayKey})`,
        `- **Agua:** ${today.water} L`,
        `- **Peso:** ${today.weight || '--'} kg`,
        `\n## Comidas Registradas`
      ];
      today.meals.forEach(m => {
        lines.push(`- **${m.time} ${m.name}** (${Math.round(m.baseWeight*m.scale)}g): ${Math.round(m.baseKcal*m.scale)} kcal | P: ${Math.round(m.baseProt*m.scale)}g | C: ${Math.round(m.baseCarb*m.scale)}g | G: ${Math.round(m.baseFat*m.scale)}g`);
      });
      navigator.clipboard.writeText(lines.join('\n'));
      alert('Copiado en formato Markdown para Obsidian.');
    }

    function downloadBackupJSON() {
      const blob = new Blob([JSON.stringify({ cfg: getCfg(), presets: getPresets(), days: getAllDays() }, null, 2)], { type: 'application/json' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `nutrios-backup-${todayKey}.json`;
      a.click();
    }

