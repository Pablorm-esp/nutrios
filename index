    }

    function renderAnalyticsView() {
      const all = getAllDays();
      const cfg = getCfg();
      const goalKcal = cfg[cfg.dayType].kcal;

      const days7 = [];
      for (let i = 6; i >= 0; i--) {
        const d = new Date();
        d.setDate(d.getDate() - i);
        const k = d.toISOString().split('T')[0];
        const lbl = d.toLocaleDateString('es-ES', { weekday: 'short' }).slice(0, 2).toUpperCase();
        const item = all[k] || { meals: [], weight: null };
        const kcal = item.meals.reduce((s, m) => s + Math.round(m.baseKcal * m.scale), 0);
        const prot = item.meals.reduce((s, m) => s + Math.round(m.baseProt * m.scale), 0);
        days7.push({ k, lbl, kcal, prot, weight: item.weight });
      }

      const active = days7.filter(d => d.kcal > 0);
      document.getElementById('statAvgKcal').textContent = `${active.length ? Math.round(active.reduce((a,b)=>a+b.kcal,0)/active.length) : 0} kcal`;
      document.getElementById('statAvgProt').textContent = `${active.length ? Math.round(active.reduce((a,b)=>a+b.prot,0)/active.length) : 0} g`;
      document.getElementById('statAdherence').textContent = `${Math.round((active.length / 7) * 100)}%`;

      const maxVal = Math.max(goalKcal * 1.15, ...days7.map(d => d.kcal), 1000);
      document.getElementById('chart7Days').innerHTML = days7.map(d => {
        const h = Math.min(100, Math.round((d.kcal / maxVal) * 100));
        const col = d.kcal > goalKcal * 1.08 ? 'bg-[#FF9F0A]' : 'bg-[#30D158]';
        return `
          <div class="flex-1 flex flex-col items-center h-full justify-end">
            <span class="text-[9px] text-[#8E8E93] mb-1">${d.kcal || ''}</span>
            <div class="w-full max-w-[22px] bg-[#2C2C2E] rounded-t-md h-24 flex items-end overflow-hidden">
              <div class="${col} w-full rounded-t-md transition-all duration-500" style="height:${h}%"></div>
            </div>
            <span class="text-[10px] font-semibold text-[#8E8E93] mt-1.5">${d.lbl}</span>
          </div>
        `;
      }).join('');

      const weights = Object.entries(all).filter(([,v]) => v.weight).sort(([a],[b]) => b.localeCompare(a)).slice(0, 7);
      document.getElementById('weightHistoryBox').innerHTML = weights.length
        ? weights.map(([dt, obj]) => `<div class="py-2 flex justify-between"><span>${dt}</span><strong class="text-[#BF5AF2]">${obj.weight} kg</strong></div>`).join('')
        : `<p class="text-[#8E8E93] py-2">Sin registros de peso todavía.</p>`;
    }

    function renderUI() {
      const cfg = getCfg();
      const goals = cfg[cfg.dayType];
      const today = getToday();

      document.getElementById('segTrain').classList.toggle('active', cfg.dayType === 'train');
      document.getElementById('segRest').classList.toggle('active', cfg.dayType === 'rest');

      let kcal = 0, prot = 0, carb = 0, fat = 0, fiber = 0;
      today.meals.forEach(m => {
        kcal  += Math.round(m.baseKcal * m.scale);
        prot  += Math.round(m.baseProt * m.scale);
        carb  += Math.round(m.baseCarb * m.scale);
        fat   += Math.round(m.baseFat * m.scale);
        fiber += Math.round((m.baseFiber || 0) * m.scale);
      });

      const cKcal = 314.16, cProt = 226.19;
      document.getElementById('ringKcal').style.strokeDashoffset = cKcal - Math.min(1, kcal / goals.kcal) * cKcal;
      document.getElementById('ringProt').style.strokeDashoffset = cProt - Math.min(1, prot / goals.prot) * cProt;

      document.getElementById('lblKcalDone').textContent = kcal;
      document.getElementById('lblKcalTarget').textContent = `/ ${goals.kcal} KCAL`;
      document.getElementById('lblProtDone').textContent = prot;
      document.getElementById('lblProtGoal').textContent = goals.prot;
      document.getElementById('lblCarbDone').textContent = carb;
      document.getElementById('lblCarbGoal').textContent = goals.carb;
      document.getElementById('lblFatDone').textContent  = fat;
      document.getElementById('lblFatGoal').textContent  = goals.fat;
      document.getElementById('lblFiberDone').textContent = `${fiber}g`;

      document.getElementById('barProt').style.width = `${Math.min(100, (prot / goals.prot) * 100)}%`;
      document.getElementById('barCarb').style.width = `${Math.min(100, (carb / goals.carb) * 100)}%`;
      document.getElementById('barFat').style.width  = `${Math.min(100, (fat / goals.fat) * 100)}%`;

      const rem = goals.kcal - kcal;
      const badge = document.getElementById('remBadge');
      badge.textContent = rem >= 0 ? `Restan ${rem} kcal` : `+${Math.abs(rem)} kcal superávit`;
      badge.className = rem >= 0
        ? 'text-[11px] font-semibold px-2.5 py-0.5 rounded-full bg-[#30D158]/15 text-[#30D158]'
        : 'text-[11px] font-semibold px-2.5 py-0.5 rounded-full bg-[#FF9F0A]/15 text-[#FF9F0A]';

      document.getElementById('lblWater').textContent = today.water.toFixed(2);
      document.getElementById('lblWeight').textContent = today.weight || '--';

      // Porcentajes en Analítica
      const totE = (prot * 4) + (carb * 4) + (fat * 9) || 1;
      const pP = Math.round(((prot * 4) / totE) * 100);
      const cP = Math.round(((carb * 4) / totE) * 100);
      const fP = Math.max(0, 100 - pP - cP);
      document.getElementById('barSplitP').style.width = `${pP}%`;
      document.getElementById('barSplitC').style.width = `${cP}%`;
      document.getElementById('barSplitF').style.width = `${fP}%`;
      document.getElementById('pctP').textContent = `${pP}%`;
      document.getElementById('pctC').textContent = `${cP}%`;
      document.getElementById('pctF').textContent = `${fP}%`;

      // Carrusel Presets con iconos vectoriales
      const presets = getPresets();
      document.getElementById('presetsCarousel').innerHTML = presets.map(p => `
        <button onclick="logPreset('${p.id}')" class="ios-card-sm shrink-0 flex items-center gap-2.5 active:scale-95 transition-transform">
          <div class="w-8 h-8 rounded-xl bg-[#2C2C2E] flex items-center justify-center text-[#0A84FF]">
            <i data-lucide="${p.icon || 'Utensils'}" class="w-4 h-4"></i>
          </div>
          <div class="text-left pr-1">
            <div class="text-[12px] font-semibold text-white leading-tight">${p.name}</div>
            <div class="text-[10px] text-[#8E8E93] mt-0.5">${p.kcal} kcal · ${p.prot}g P</div>
          </div>
        </button>
      `).join('');

      document.getElementById('savedPresetsList').innerHTML = presets.map(p => `
        <div class="ios-row">
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-lg bg-[#2C2C2E] flex items-center justify-center text-[#0A84FF]">
              <i data-lucide="${p.icon || 'Utensils'}" class="w-4 h-4"></i>
            </div>
            <div>
              <div class="text-[13px] font-semibold text-white">${p.name}</div>
              <div class="text-[11px] text-[#8E8E93]">${p.weight}g · ${p.kcal} kcal · P:${p.prot}g C:${p.carb}g G:${p.fat}g</div>
            </div>
          </div>
          <button onclick="deletePreset('${p.id}')" class="text-[#FF453A] p-1.5">
            <i data-lucide="Trash2" class="w-4 h-4"></i>
          </button>
        </div>
      `).join('');

      // Lista de Comidas
      const listEl = document.getElementById('mealsList');
      if (today.meals.length === 0) {
        listEl.innerHTML = `
          <div class="ios-card py-8 flex flex-col items-center justify-center text-center">
            <div class="w-10 h-10 rounded-full bg-[#2C2C2E] flex items-center justify-center text-[#8E8E93] mb-2">
              <i data-lucide="Utensils" class="w-5 h-5"></i>
            </div>
            <p class="text-[13px] font-semibold text-white">Sin comidas registradas hoy</p>
            <p class="text-[11px] text-[#8E8E93] mt-0.5">Pulsa el botón azul de cámara o elige un plato rápido arriba.</p>
          </div>
        `;
        lucide.createIcons();
        return;
      }

      listEl.innerHTML = today.meals.map(m => `
        <div class="ios-card">
          <div class="flex justify-between items-start gap-3">
            <div class="flex items-center gap-3">
              ${m.thumb
                ? `<img src="${m.thumb}" class="w-12 h-12 rounded-xl object-cover border border-white/10 shrink-0" />`
                : `<div class="w-12 h-12 rounded-xl bg-[#2C2C2E] flex items-center justify-center text-[#0A84FF] shrink-0">
                     <i data-lucide="${m.icon || 'Utensils'}" class="w-5 h-5"></i>
                   </div>`
              }
              <div>
                <h3 class="text-[14px] font-semibold text-white leading-snug">${m.name}</h3>
                <p class="text-[11px] text-[#8E8E93] mt-0.5">${m.time} · ~${Math.round(m.baseWeight * m.scale)} g</p>
              </div>
            </div>
            <div class="flex items-center gap-1">
              <button onclick="saveMealToFavorites(${m.id})" class="p-1.5 text-[#8E8E93] active:text-[#0A84FF]" title="Guardar en favoritos">
                <i data-lucide="Bookmark" class="w-4 h-4"></i>
              </button>
              <button onclick="deleteMeal(${m.id})" class="p-1.5 text-[#8E8E93] active:text-[#FF453A]">
                <i data-lucide="X" class="w-4 h-4"></i>
              </button>
            </div>
          </div>

          <div class="grid grid-cols-4 gap-1.5 mt-3 bg-black/40 rounded-xl p-2 text-center border border-white/5">
            <div><span class="text-[10px] text-[#8E8E93] block">Kcal</span><span class="text-[12px] font-bold text-[#30D158]">${Math.round(m.baseKcal * m.scale)}</span></div>
            <div><span class="text-[10px] text-[#8E8E93] block">Proteína</span><span class="text-[12px] font-bold text-[#0A84FF]">${Math.round(m.baseProt * m.scale)}g</span></div>
            <div><span class="text-[10px] text-[#8E8E93] block">Carbos</span><span class="text-[12px] font-bold text-[#FF9F0A]">${Math.round(m.baseCarb * m.scale)}g</span></div>
            <div><span class="text-[10px] text-[#8E8E93] block">Grasas</span><span class="text-[12px] font-bold text-[#FF453A]">${Math.round(m.baseFat * m.scale)}g</span></div>
          </div>

          <p class="text-[11px] text-[#8E8E93] mt-2 leading-relaxed">${(m.items || []).join(' · ')}</p>

          <div class="flex items-center gap-3 mt-3 pt-2.5 border-t border-[#2C2C2E]">
            <span class="text-[11px] text-[#8E8E93] w-20">Ración: <strong class="text-white">${m.scale}x</strong></span>
            <input type="range" min="0.5" max="2.0" step="0.1" value="${m.scale}" oninput="updateScale(${m.id}, this.value)" class="flex-1" />
          </div>
        </div>
      `).join('');

      lucide.createIcons();
    }

    renderUI();
  </script>
</body>
</html>
